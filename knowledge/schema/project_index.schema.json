{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xiaoyou_project_index_v2",
  "title": "XiaoYou Project Knowledge Index",
  "type": "object",
  "required": [
    "schema_version",
    "knowledge_revision",
    "project",
    "repository",
    "knowledge_branch",
    "code_branch",
    "updated_at",
    "authority",
    "current",
    "roadmap",
    "roles",
    "freshness_policy",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "xiaoyou_project_knowledge_v2"
    },
    "knowledge_revision": {
      "type": "integer",
      "minimum": 2
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "knowledge_branch": {
      "const": "project-knowledge"
    },
    "code_branch": {
      "const": "main"
    },
    "repository_visibility": {
      "enum": [
        "public",
        "private",
        "internal"
      ]
    },
    "updated_at": {
      "type": "string",
      "minLength": 10
    },
    "authority": {
      "type": "object",
      "required": [
        "dynamic_current_state",
        "human_current_state",
        "active_work",
        "evidence",
        "code",
        "deployed_runtime"
      ]
    },
    "current": {
      "type": "object",
      "required": [
        "formal_stage",
        "production_sha",
        "production_last_verified_at",
        "main_sha",
        "main_last_verified_at",
        "active_work_item_id",
        "blocker_id",
        "blocker_status",
        "blocker_summary",
        "next_action"
      ],
      "properties": {
        "formal_stage": {
          "type": "object",
          "required": [
            "id",
            "name",
            "status",
            "sealed"
          ]
        },
        "production_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "active_work_item_id": {
          "type": "string",
          "minLength": 1
        },
        "blocker_id": {
          "type": "string",
          "minLength": 1
        },
        "blocker_status": {
          "type": "string",
          "minLength": 1
        },
        "blocker_summary": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sealed_capabilities": {
      "type": "array"
    },
    "roadmap": {
      "type": "array",
      "minItems": 1
    },
    "roles": {
      "type": "object",
      "required": [
        "owner",
        "chatgpt",
        "codex"
      ]
    },
    "freshness_policy": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "required": [
        "public_safe_only",
        "never_store"
      ]
    }
  }
}
