[Unit]
Description=Queue Hermes Youyi weekly public industry learning report
After=network-online.target hermes-youyi-019.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-youyi
Group=hermes-youyi
WorkingDirectory=/opt/hermes-youyi-upgrade-0.19.0/runtime
EnvironmentFile=/opt/hermes-youyi/config/runtime.secrets.env
EnvironmentFile=/opt/hermes-youyi-upgrade-0.19.0/config/runtime.gateway.019.env
Environment=HERMES_TUOGUAN_DATA_DIR=/opt/hermes-youyi/data/tuoguan-data
ExecStart=/opt/hermes-youyi-upgrade-0.19.0/.venv/bin/python -m plugins.tuoguan_core.external_learning_runner weekly_industry
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hermes-youyi/data/tuoguan-data
StandardOutput=journal
StandardError=journal
