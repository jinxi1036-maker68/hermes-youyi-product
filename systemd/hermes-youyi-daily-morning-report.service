[Unit]
Description=Queue Hermes Youyi daily morning boss report
After=network-online.target hermes-youyi-019.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-youyi
Group=hermes-youyi
WorkingDirectory=/opt/hermes-youyi-current/runtime
EnvironmentFile=/opt/hermes-youyi/config/runtime.secrets.env
EnvironmentFile=/opt/hermes-youyi-current/config/runtime.gateway.020.env
Environment=HERMES_CONFIG_PATH=/opt/hermes-youyi-current/home-proddata/config.yaml
Environment=HERMES_TUOGUAN_DATA_DIR=/opt/hermes-youyi/data/tuoguan-data
ExecStart=/opt/hermes-youyi-current/.venv/bin/python -m plugins.tuoguan_core.daily_reporter morning --drain-outbox
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hermes-youyi/data/tuoguan-data
StandardOutput=journal
StandardError=journal
