[Unit]
Description=Drain Hermes Youyi trusted notification outbox
After=network-online.target hermes-youyi-019.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes-youyi
Group=hermes-youyi
WorkingDirectory=/opt/hermes-youyi-current/runtime
EnvironmentFile=/opt/hermes-youyi/config/runtime.secrets.env
EnvironmentFile=/opt/hermes-youyi-current/config/runtime.gateway.020.env
Environment=HERMES_TUOGUAN_DATA_DIR=/opt/hermes-youyi/data/tuoguan-data
ExecStart=/opt/hermes-youyi-current/.venv/bin/python -m plugins.tuoguan_core.notification_outbox_runner
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/hermes-youyi/data/tuoguan-data /opt/hermes-youyi/logs
StandardOutput=journal
StandardError=journal
