# XiaoYou WeCom bootstrap holding bridge - non-secret runtime configuration.
# Real values belong in a protected deployment-local EnvironmentFile.

XIAOYOU_WECOM_HOLDING_HOST=127.0.0.1
XIAOYOU_WECOM_HOLDING_PORT=19191
XIAOYOU_WECOM_HOLDING_CALLBACK_PATH=/wecom/callback
XIAOYOU_WECOM_HOLDING_UPSTREAM=http://127.0.0.1:8866
XIAOYOU_WECOM_HOLDING_STATE_ROOT=/var/lib/hermes-youyi/ingress-holding
XIAOYOU_WECOM_HOLDING_FORWARD_TIMEOUT=2.0
XIAOYOU_WECOM_HOLDING_LOG_LEVEL=INFO

# Transport signature verification secret(s) MUST come from a protected
# secret EnvironmentFile, never this versioned file.
#
# Single callback app:
#   WECOM_CALLBACK_TOKEN=...
#
# Multiple callback apps:
#   XIAOYOU_WECOM_HOLDING_TOKENS_JSON=["...","..."]
