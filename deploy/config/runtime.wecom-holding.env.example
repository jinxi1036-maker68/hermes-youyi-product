# Bootstrap WeCom callback holding bridge.
# Only non-secret runtime settings belong here.
# Verify the chosen loopback port is unused on the target server before deploy.
#
# Bridge durability is intentionally OUTSIDE Gateway HERMES_HOME so the first
# runtime-home finalize cannot prune live callback backlog/control state.

XIAOYOU_WECOM_HOLDING_STATE_ROOT=/var/lib/hermes-youyi/wecom-holding
XIAOYOU_WECOM_HOLDING_HOST=127.0.0.1
XIAOYOU_WECOM_HOLDING_PORT=19091
XIAOYOU_WECOM_HOLDING_UPSTREAM=http://127.0.0.1:19090
XIAOYOU_WECOM_HOLDING_TIMEOUT_SECONDS=5
XIAOYOU_WECOM_HOLDING_REPLAY_INTERVAL_SECONDS=1
XIAOYOU_WECOM_HOLDING_REPLAY_BATCH_SIZE=50

# Optional explicit paths. Defaults are under XIAOYOU_WECOM_HOLDING_STATE_ROOT.
# XIAOYOU_WECOM_HOLDING_DB=/var/lib/hermes-youyi/wecom-holding/wecom_callback_holding.sqlite3
# XIAOYOU_WECOM_HOLDING_MODE_FILE=/var/lib/hermes-youyi/wecom-holding/wecom_callback_holding_mode.json
