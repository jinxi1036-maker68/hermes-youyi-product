# Non-secret runtime paths and identity. Keep real values in a protected,
# deployment-local environment file; do not commit it.
HERMES_HOME=${HERMES_PERSISTENT_HOME}
HERMES_CONFIG_PATH=${HERMES_HOME}/config.yaml
PYTHONPATH=${XIAOYOU_CAPABILITY_ROOT}/runtime/plugins
HERMES_TENANT_ID=${TENANT_ID}
XIAOYOU_INSTITUTION_WORKSPACE=${XIAOYOU_WORKSPACE_ROOT}
XIAOYOU_AGENDA_SERVICE_INGRESS_DB=${XIAOYOU_WORKSPACE_ROOT}/data/agenda_work_runtime.sqlite
XIAOYOU_AGENDA_ALLOWED_USERS=service:agenda:${TENANT_ID}
