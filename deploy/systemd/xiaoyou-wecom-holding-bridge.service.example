[Unit]
Description=XiaoYou WeCom Bootstrap Holding Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-youyi
Group=hermes-youyi
WorkingDirectory=${HERMES_RUNTIME_ROOT}
EnvironmentFile=/etc/xiaoyou/runtime.wecom-holding.env
Environment=PYTHONPATH=${HERMES_RUNTIME_ROOT}/runtime
ExecStart=${HERMES_RUNTIME_ROOT}/.venv/bin/python ${HERMES_RUNTIME_ROOT}/scripts/xiaoyou_wecom_holding_bridge.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Provision and verify this directory with
# scripts/xiaoyou_wecom_holding_state_root.py before enabling the service.
# This path must match XIAOYOU_WECOM_HOLDING_STATE_ROOT after template substitution.
# Do not grant write access to Gateway HERMES_HOME for bootstrap holding state.
ReadWritePaths=${XIAOYOU_WECOM_HOLDING_STATE_ROOT}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
