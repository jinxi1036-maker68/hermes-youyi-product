[Unit]
Description=XiaoYou WeCom Bootstrap Holding Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${XIAOYOU_SERVICE_USER}
Group=${XIAOYOU_SERVICE_GROUP}
WorkingDirectory=${XIAOYOU_RELEASE_PAYLOAD_ROOT}
EnvironmentFile=/etc/xiaoyou/runtime.wecom-holding.env
# Entrypoint loads holding_bridge.py from the exact staged payload by file path;
# do not use PYTHONPATH package precedence for this bootstrap boundary.
ExecStart=${HERMES_PYTHON} ${XIAOYOU_RELEASE_PAYLOAD_ROOT}/scripts/xiaoyou_wecom_holding_bridge.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Candidate code is immutable at runtime; only the dedicated holding state is writable.
ReadOnlyPaths=${XIAOYOU_RELEASE_PAYLOAD_ROOT}
# Provision and verify this directory with
# scripts/xiaoyou_wecom_holding_state_root.py before enabling the service.
# This path must match XIAOYOU_WECOM_HOLDING_STATE_ROOT after template substitution.
# Do not grant write access to Gateway HERMES_HOME for bootstrap holding state.
ReadWritePaths=${XIAOYOU_WECOM_HOLDING_STATE_ROOT}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
