[Unit]
Description=XiaoYou Agenda and Wake Coordinator
After=network-online.target xiaoyou-gateway.service
Wants=network-online.target
Requires=xiaoyou-gateway.service

[Service]
Type=simple
User=xiaoyou
Group=xiaoyou
WorkingDirectory=${HERMES_RUNTIME_ROOT}
EnvironmentFile=/etc/xiaoyou/runtime.gateway.env
Environment=PYTHONPATH=${XIAOYOU_CAPABILITY_ROOT}/runtime/plugins
ExecStart=${HERMES_RUNTIME_ROOT}/.venv/bin/python -m tuoguan_core.agenda_runtime --interval-seconds 15
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=${XIAOYOU_WORKSPACE_ROOT} /var/log/xiaoyou

[Install]
WantedBy=multi-user.target
