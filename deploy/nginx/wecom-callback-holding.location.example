# Apply this exact callback-only location to BOTH current HTTP:80 and HTTPS:443
# server blocks during the controlled bootstrap cutover.
#
# DO NOT change the shared "hermes_hub" upstream: it also serves /health and
# /api/v1 and must remain pointed at 127.0.0.1:19090.
#
# Replace HOLDING_PORT with the verified loopback listener port.

location = /wecom/callback {
    proxy_pass http://127.0.0.1:HOLDING_PORT;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WeCom callback requests are short HTTP requests. The bridge owns
    # durable fallback/replay; Nginx must not synthesize an ACK.
    proxy_connect_timeout 3s;
    proxy_send_timeout 5s;
    proxy_read_timeout 5s;
}
